includes:
    - /composer/vendor/phpstan/phpstan-strict-rules/rules.neon
    - /composer/vendor/phpstan/phpstan-phpunit/extension.neon
    - /composer/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    editorUrl: ''
    editorUrlTitle: '%%relFile%%:%%line%%'
    ignoreErrors:
        -
            message: '#^PHPDoc tag @template T for class Typhoon\\Type\\CallableT with bound type callable is not supported\.$#'
            identifier: generics.notSupportedBound
            count: 1
            path: src/Type/CallableT.php

    # strict rules
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    rememberPossiblyImpureFunctionValues: false
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true
